/[-\s]+/ on "a_b-c": test true, count 1, replace "a_b_c", replaceAll "a_b_c", findAll [-]
/[-\s]+/ on "user_account-ID  two": test true, count 2, replace "user_account_ID  two", replaceAll "user_account_ID_two", findAll [-|  ]
/[ab]/ on "cabbage": test true, count 4, replace "c_bbage", replaceAll "c____ge", findAll [a|b|b|a]
/[ab]+/ on "cabbage": test true, count 1, replace "c_ge", replaceAll "c_ge", findAll [abba]
/[ab]*/ on "cab": test true, count 3, replace "_cab", replaceAll "_c__", findAll [|ab|]
/[a-c]{2,}/ on "abcxab-a-cba": test true, count 3, replace "_xab-a-cba", replaceAll "_x_-a-_", findAll [abc|ab|cba]
/[^a-z]+/ on "ab12cd--ef": test true, count 2, replace "ab_cd--ef", replaceAll "ab_cd_ef", findAll [12|--]
/\s+/ on "one  two	three": test true, count 2, replace "one_two	three", replaceAll "one_two_three", findAll [  |	]
/\d+|x/ on "a1x22b333": test true, count 4, replace "a_x22b333", replaceAll "a___b_", findAll [1|x|22|333]
/[AB]+/i on "xaBbAy": test true, count 1, replace "x_y", replaceAll "x_y", findAll [aBbA]
/(?:ab|cd)+/ on "abcdxcdab": test true, count 2, replace "_xcdab", replaceAll "_x_", findAll [abcd|cdab]
