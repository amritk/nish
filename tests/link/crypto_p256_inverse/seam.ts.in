
// ---- Test seam: appended by tests/run.js ("p256 inverse: ...") to a copy of ----
// std/crypto/p256.ts and never part of the module itself. It exports the two
// ways this file inverts a scalar mod n and a field element mod p, and both ways
// it computes u1 G + u2 Q, and the field arithmetic beside a bit-serial
// reference, so tests/link/crypto_p256_inverse can
// hold them to each other without the module growing a public API for it.

/**
 * `out = 1 / a` mod n as `a^(n - 2)`, square-and-multiply with the scalar
 * Montgomery multiply on the public exponent: the Fermat ladder the module
 * used before `p256ScalarInverse`, kept here as its reference.
 */
const p256SeamScalarFermat = (out: u32[], a: u32[]): void => {
  const e: u32[] = p256Order()
  e[0] = e[0] - 2
  const acc: u32[] = p256Limbs()
  // One in the Montgomery domain: 2^256 mod n, least significant limb first.
  p256SetLimbs(
    acc,
    0x39cdaaf,
    0xc46353d,
    0x58e8617b,
    0x43190552,
    0x0,
    0x0,
    0xffffffff,
    0x0
  )
  for (let bit: i32 = 255; bit >= 0; bit--) {
    p256FiatScalarMul(acc, acc, acc)
    const word: u32 = e[bit / 32]
    if (((word >> toU32(bit % 32)) & 1) === 1) {
      p256FiatScalarMul(acc, acc, a)
    }
  }
  p256Copy(out, acc)
}

/** `k mod n`, inverted by `p256ScalarInverse` (safegcd) or the seam's Fermat ladder, as 32 big-endian bytes. */
const p256SeamInvertWith = (k: u8[], safegcd: boolean): u8[] => {
  const plain: u32[] = p256Limbs()
  const a: u32[] = p256Limbs()
  p256LimbsFromBytes(plain, k, 0)
  p256ReduceOnce(a, plain, p256Order())
  p256FiatScalarMul(a, a, p256ScalarR2())
  if (safegcd) {
    p256ScalarInverse(a, a)
  } else {
    p256SeamScalarFermat(a, a)
  }
  p256FiatScalarMul(a, a, p256PlainOne())
  const out: u8[] = new Array<u8>(32)
  p256LimbsToBytes(out, 0, a)
  return out
}

/** 1 / (k mod n) by safegcd, the signing and verify paths' inversion. */
export const p256SeamInverse = (k: u8[]): u8[] => p256SeamInvertWith(k, true)

/** 1 / (k mod n) by Fermat, the reference. */
export const p256SeamInvert = (k: u8[]): u8[] => p256SeamInvertWith(k, false)

/** `x mod p`, inverted by `p256FieldInvert` (safegcd and R^3) or, as the reference, by a^(p - 2) in plain square-and-multiply, as 32 big-endian bytes. */
const p256SeamFieldInvertWith = (x: u8[], safegcd: boolean): u8[] => {
  const plain: u32[] = p256Limbs()
  const a: u32[] = p256Limbs()
  p256LimbsFromBytes(plain, x, 0)
  p256ReduceOnce(a, plain, p256Prime())
  p256FiatMul(a, a, p256FieldR2())
  const out32: u32[] = p256Limbs()
  if (safegcd) {
    p256FieldInvert(out32, a)
  } else {
    // p - 2's top bit is set: start from a and walk bits 254 down to 0.
    const e: u32[] = p256Prime()
    e[0] = e[0] - 2
    for (let i: i32 = 0; i < toI32(out32.length); i++) {
      if (i < toI32(a.length)) {
        out32[i] = a[i]
      }
    }
    for (let bit: i32 = 254; bit >= 0; bit--) {
      p256FiatSquare(out32, out32)
      const word: u32 = e[bit / 32]
      if (((word >> toU32(bit % 32)) & 1) === 1) {
        p256FiatMul(out32, out32, a)
      }
    }
  }
  p256FiatMul(out32, out32, p256PlainOne())
  const out: u8[] = new Array<u8>(32)
  p256LimbsToBytes(out, 0, out32)
  return out
}

/** 1 / (x mod p) by `p256FieldInvert`, the safegcd every affine conversion uses. */
export const p256SeamFieldInverse = (x: u8[]): u8[] => p256SeamFieldInvertWith(x, true)

/** 1 / (x mod p) by Fermat, the reference. */
export const p256SeamFieldInvert = (x: u8[]): u8[] => p256SeamFieldInvertWith(x, false)

/**
 * `u1 G + u2 Q` for `Q = k G`, encoded uncompressed: by `p256DoubleMultPublic`
 * (the verify path's wNAF pass) when `wnaf`, by two constant-time
 * `p256ScalarMult` calls and one addition otherwise. `u1`, `u2` and `k` are
 * 32 big-endian bytes below n.
 */
const p256SeamDoubleMultWith = (u1: u8[], u2: u8[], k: u8[], wnaf: boolean): u8[] => {
  const s = new P256PointScratch()
  const q = new P256ProjectivePoint()
  p256BaseMult(q, k, s)
  const sum = new P256ProjectivePoint()
  if (wnaf) {
    p256DoubleMultPublic(sum, u1, u2, q, s)
  } else {
    const a = new P256ProjectivePoint()
    const b = new P256ProjectivePoint()
    p256ScalarMult(a, u1, p256Generator(), s)
    p256ScalarMult(b, u2, q, s)
    p256PointAdd(sum, a, b, s)
  }
  return p256EncodePoint(sum)
}

/** `u1 G + u2 (k G)` by the wNAF pass `p256Verify` takes. */
export const p256SeamDoubleMult = (u1: u8[], u2: u8[], k: u8[]): u8[] => p256SeamDoubleMultWith(u1, u2, k, true)

/** `u1 G + u2 (k G)` by two constant-time multiplications, the reference. */
export const p256SeamDoubleMultReference = (u1: u8[], u2: u8[], k: u8[]): u8[] =>
  p256SeamDoubleMultWith(u1, u2, k, false)

/** 32 big-endian bytes as field limbs reduced once mod p: every 256-bit value is below 2p. */
const p256SeamFieldLimbs = (x: u8[]): u32[] => {
  const plain: u32[] = p256Limbs()
  const a: u32[] = p256Limbs()
  p256LimbsFromBytes(plain, x, 0)
  p256ReduceOnce(a, plain, p256Prime())
  return a
}

/**
 * Field op `op` on `x` and `y` reduced mod p, by fiat's 64-bit-limb functions
 * the module runs: 0 `p256FiatMul` (x y / 2^256), 1 `p256FiatSquare` (x x /
 * 2^256), 2 `p256FiatAdd`, 3 `p256FiatSub`. 32 big-endian bytes.
 */
export const p256SeamFieldOp = (op: i32, x: u8[], y: u8[]): u8[] => {
  const a: u32[] = p256SeamFieldLimbs(x)
  const b: u32[] = p256SeamFieldLimbs(y)
  const r: u32[] = p256Limbs()
  if (op === 0) {
    p256FiatMul(r, a, b)
  } else if (op === 1) {
    p256FiatSquare(r, a)
  } else if (op === 2) {
    p256FiatAdd(r, a, b)
  } else {
    p256FiatSub(r, a, b)
  }
  const out: u8[] = new Array<u8>(32)
  p256LimbsToBytes(out, 0, r)
  return out
}

/** `t += a` over nine 32-bit limbs, `a` eight or nine long; the carry out of limb 8 is dropped. */
const p256SeamRefAdd = (t: u32[], a: u32[]): void => {
  let carry: u64 = 0
  for (let i: i32 = 0; i < 9 && i < toI32(t.length); i++) {
    let word: u64 = 0
    if (i < toI32(a.length)) {
      word = toU64(a[i])
    }
    const sum: u64 = toU64(t[i]) + word + carry
    t[i] = toU32(sum)
    carry = sum >> toU64(32)
  }
}

/** `t -= a` over nine 32-bit limbs, `a` eight long, for `t >= a`. */
const p256SeamRefSub = (t: u32[], a: u32[]): void => {
  let borrow: u64 = 0
  for (let i: i32 = 0; i < 9 && i < toI32(t.length); i++) {
    let word: u64 = 0
    if (i < toI32(a.length)) {
      word = toU64(a[i])
    }
    const diff: u64 = toU64(t[i]) - word - borrow
    t[i] = toU32(diff)
    borrow = (diff >> toU64(63)) & toU64(1)
  }
}

/** Whether nine-limb `t` is at least eight-limb `a`. */
const p256SeamRefAtLeast = (t: u32[], a: u32[]): boolean => {
  if (toI32(t.length) < 9 || toI32(a.length) < 8) {
    return false
  }
  if (t[8] !== 0) {
    return true
  }
  for (let i: i32 = 7; i >= 0; i--) {
    if (t[i] !== a[i]) {
      return t[i] > a[i]
    }
  }
  return true
}

/**
 * The reference for `p256SeamFieldOp`, sharing none of fiat's arithmetic: the
 * multiply is bit-serial Montgomery reduction (for each bit of x, low first,
 * add y if it is set, add p if the sum is odd, halve; then subtract p once),
 * which stays below 2p over nine 32-bit limbs; add and subtract are a plain
 * carry chain and one correction by p.
 */
export const p256SeamFieldOpReference = (op: i32, x: u8[], y: u8[]): u8[] => {
  const a: u32[] = p256SeamFieldLimbs(x)
  const b: u32[] = op === 1 ? p256SeamFieldLimbs(x) : p256SeamFieldLimbs(y)
  const p: u32[] = p256Prime()
  const t: u32[] = new Array<u32>(9)
  if (op === 0 || op === 1) {
    for (let bit: i32 = 0; bit < 256; bit++) {
      if (((a[bit / 32] >> toU32(bit % 32)) & 1) === 1) {
        p256SeamRefAdd(t, b)
      }
      if ((t[0] & 1) === 1) {
        p256SeamRefAdd(t, p)
      }
      for (let i: i32 = 0; i < 8; i++) {
        t[i] = (t[i] >> 1) | (t[i + 1] << 31)
      }
      t[8] = t[8] >> 1
    }
  } else if (op === 2) {
    p256SeamRefAdd(t, a)
    p256SeamRefAdd(t, b)
  } else {
    p256SeamRefAdd(t, a)
    if (!p256SeamRefAtLeast(t, b)) {
      p256SeamRefAdd(t, p)
    }
    p256SeamRefSub(t, b)
  }
  if (p256SeamRefAtLeast(t, p)) {
    p256SeamRefSub(t, p)
  }
  const r: u32[] = p256Limbs()
  for (let i: i32 = 0; i < 8 && i < toI32(r.length); i++) {
    r[i] = t[i]
  }
  const out: u8[] = new Array<u8>(32)
  p256LimbsToBytes(out, 0, r)
  return out
}
