{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/no-attribution.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run format)",
      "Bash(npm run smoke)",
      "Bash(npm run bootstrap)",
      "Bash(npm run size-report)",
      "Bash(npm test)",
      "Bash(npm run test:update)",
      "Bash(npm run test:diff)",
      "Bash(node tests/run.js:*)",
      "Bash(node tests/differential/run.js:*)",
      "Bash(node tests/differential/fuzz.js:*)",
      "Bash(node dist/index.js:*)",
      "Bash(build/nish:*)",
      "Bash(build/seed/bin/nish:*)",
      "Bash(node docs/check-links.mjs)",
      "Bash(node bench/run.mjs)",
      "Bash(bash scripts/build.sh:*)",
      "Bash(bash scripts/fetch-seed.sh:*)",
      "Bash(bash scripts/smoke.sh)",
      "Bash(bash scripts/size-report.sh:*)",
      "Bash(bash docs/cookbook/regen.sh:*)",
      "Bash(npx biome:*)",
      "Bash(clang:*)",
      "Bash(llc:*)",
      "Bash(llvm-as:*)",
      "Bash(opt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
