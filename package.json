{
  "name": "@amritk/nish",
  "version": "0.3.0",
  "description": "Nish: an ahead-of-time compiler from a static subset of TypeScript to LLVM IR",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./runtime/*": "./runtime/*",
    "./scripts/*": "./scripts/*",
    "./*": "./std/*.ts"
  },
  "bin": {
    "nish": "bin/nish"
  },
  "files": [
    "dist",
    "bin",
    "runtime",
    "scripts",
    "!scripts/arrow-verify.mjs",
    "std",
    "README.md",
    "LICENSE",
    "llms.txt",
    "docs/AI.md",
    "docs/INSTALL.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "postinstall": "node scripts/postinstall.mjs",
    "bootstrap": "npm run build && bash scripts/bootstrap.sh",
    "compile": "node dist/index.js",
    "example": "npm run build && node dist/index.js examples/add.ts -o build/add.ll && cat build/add.ll",
    "test": "npm run build && node tests/run.js",
    "size-report": "npm run build && node dist/index.js examples/add.ts -o build/add.ll && bash scripts/size-report.sh build/add.ll examples/main.c",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:update": "npm run build && UPDATE_GOLDENS=1 node tests/run.js",
    "test:diff": "npm run build && node tests/differential/run.js",
    "test:nish": "npm run build && node dist/index.js tests/nish/run.ts -o build/nish-runner.ir/ --link build/nish-runner && build/nish-runner",
    "test:cli": "npm run build && node dist/index.js tests/nish/cli.ts -o build/nish-cli.ir/ --link build/nish-cli && build/nish-cli",
    "test:node": "npm run build && node tests/differential/unmodified.js",
    "lint": "biome check --formatter-enabled=false .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run check && npm run build && npm test",
    "changelog": "node scripts/changelog-gen.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amritk/nish.git"
  },
  "bugs": {
    "url": "https://github.com/amritk/nish/issues"
  },
  "homepage": "https://github.com/amritk/nish#readme",
  "keywords": [
    "typescript",
    "compiler",
    "llvm",
    "llvm-ir",
    "ahead-of-time",
    "aot",
    "native",
    "wasm",
    "webassembly",
    "nish"
  ],
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@amritk/nish-x86_64-linux": "0.3.0",
    "@amritk/nish-aarch64-linux": "0.3.0",
    "@amritk/nish-aarch64-darwin": "0.3.0",
    "@amritk/nish-x86_64-darwin": "0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22.0.0"
  }
}
