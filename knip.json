{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/compile.ts",
    "src/dump-*.ts",
    "src/break-*.ts",
    "std/*.ts",
    "tests/nish/*.ts",
    "test/spec/*.ts",
    "tests/self/*.ts",
    "tests/fuzz/targets/*.ts",
    "tests/postgres/**/*.ts",
    "tests/**/*.{js,mjs}",
    "scripts/**/*.{js,mjs}",
    "bin/*.js",
    "web/*.mjs",
    "examples/**/*.{ts,mjs}",
    "docs/*.mjs",
    "docs/site/*.js",
    "docs/cookbook/**/*.ts",
    "bench/**/*.{ts,mjs}",
    ".claude/hooks/*.mjs"
  ],
  "project": ["**/*.{ts,js,mjs}"],
  "ignore": [
    "tests/emit-ts/**",
    "tests/cases/**",
    "tests/link/**",
    "tests/wordings/**",
    "tests/c-symbols/**",
    "tests/fix/**",
    "tests/host-import/**",
    "tests/parser/**",
    "tests/lexer/**",
    "tests/layout/**",
    "tests/differential/corpus/**",
    "tests/differential/arrow-parity/**",
    "tests/host-window/**",
    "tests/module-storage/**",
    "tests/page/**",
    "tests/panic/**",
    "docs/site/break/**"
  ],
  "ignoreDependencies": ["cookbook-pkg", "elysia", "hono"],
  "ignoreBinaries": ["clang", "ld.lld", "llc", "llvm-as", "llvm-dwarfdump", "llvm-link", "llvm-nm", "openssl", "opt", "size", "nish", "unshare", "wrk", "taskset", "strace", "h2load", "script", "gdb", "lldb"],
  "ignoreExportsUsedInFile": false
}
