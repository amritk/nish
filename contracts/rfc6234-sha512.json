    {
      "kind": "property",
      "id": "P-LEN-512",
      "title": "sha512 gives 64 bytes for any message",
      "covers": ["R-DIGEST", "R-SHA512-OUT"],
      "forall": [
        {
          "name": "m",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 300
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "call": "sha512",
                "args": [
                  {
                    "var": "m"
                  }
                ]
              }
            ]
          },
          {
            "int": 64
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-LEN-384",
      "title": "sha384 gives 48 bytes for any message",
      "covers": ["R-DIGEST", "R-SHA384-OUT"],
      "forall": [
        {
          "name": "m",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 300
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "call": "sha384",
                "args": [
                  {
                    "var": "m"
                  }
                ]
              }
            ]
          },
          {
            "int": 48
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-384-IV",
      "title": "SHA-384 starts from its own initial hash value, so it is not SHA-512 cut to 48 bytes",
      "covers": ["R-SHA384-IV"],
      "forall": [
        {
          "name": "m",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 300
        }
      ],
      "assert": {
        "op": "!=",
        "args": [
          {
            "call": "sha384",
            "args": [
              {
                "var": "m"
              }
            ]
          },
          {
            "op": "slice",
            "args": [
              {
                "call": "sha512",
                "args": [
                  {
                    "var": "m"
                  }
                ]
              },
              {
                "int": 0
              },
              {
                "int": 48
              }
            ]
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-CHUNK",
      "title": "the digest depends on every byte: appending one byte changes it",
      "covers": ["R-DIGEST"],
      "forall": [
        {
          "name": "m",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 300
        },
        {
          "name": "b",
          "type": "bytes",
          "minLen": 1,
          "maxLen": 1
        }
      ],
      "assert": {
        "op": "!=",
        "args": [
          {
            "call": "sha512",
            "args": [
              {
                "var": "m"
              }
            ]
          },
          {
            "call": "sha512",
            "args": [
              {
                "op": "concat",
                "args": [
                  {
                    "var": "m"
                  },
                  {
                    "var": "b"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "outOfScope": [
    {
      "name": "Sha512",
      "reason": "the streaming form of sha512; a vector row and a property here call only functions, so the classes are left to nish's own tests (tests/run.js)"
    },
    {
      "name": "Sha384",
      "reason": "the streaming form of sha384; a vector row and a property here call only functions, so the classes are left to nish's own tests (tests/run.js)"
    },
    {
      "name": "SHA512_SIZE",
      "reason": "a constant, not a function; the properties test the digest length it names"
    },
    {
      "name": "SHA384_SIZE",
      "reason": "a constant, not a function; the properties test the digest length it names"
    },
    {
      "name": "SHA512_BLOCK",
      "reason": "a constant, not a function; it names the block size the two-block vectors cross"
    }
  ]
