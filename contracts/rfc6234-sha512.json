      "title": "RFC 6234 §8.5: SHA-384 test 1, \"abc\", one block",
      "covers": ["R-SHA384-OUT", "R-DRIVER", "R-ASCII"],
      "source": {
        "command": "python3 -c 'import hashlib; print(hashlib.sha384(b\"abc\").hexdigest())'"
      },
      "section": "7",
      "sectionSource": "rfc6234-sha512",
      "call": "sha384",
      "args": [
