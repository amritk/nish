{
  "$schema": "../build/vector/schemas/rfc-contract.json",
  "contract": "rfc7748-x25519",
  "source": {
    "rfc": 7748,
    "title": "Elliptic Curves for Security: X25519",
    "sha256": "279ca0ecc5e92e2962e27b846986aeb74729d9dd34bd4a04a362f80dcb596ad3"
  },
  "sources": [
    {
      "id": "rfc7748",
      "rfc": 7748,
      "file": "rfcs/rfc7748.txt",
      "sha256": "279ca0ecc5e92e2962e27b846986aeb74729d9dd34bd4a04a362f80dcb596ad3"
    }
  ],
  "target": {
    "module": "nish/crypto/x25519"
  },
  "requirements": [
    {
      "id": "R-FUNC",
      "section": "5",
      "level": "DEFINITION",
      "quote": "The functions take a scalar and a u-coordinate as inputs and produce a u-coordinate as output."
    },
    {
      "id": "R-SIZE",
      "section": "5",
      "level": "DEFINITION",
      "quote": "Although the functions work internally with integers, the inputs and outputs are 32-byte strings (for X25519) or 56-byte strings (for X448) and this specification defines their encoding."
    },
    {
      "id": "R-MASK",
      "section": "5",
      "level": "MUST",
      "quote": "When receiving such an array, implementations of X25519 (but not X448) MUST mask the most significant bit in the final byte."
    },
    {
      "id": "R-NONCANON",
      "section": "5",
      "level": "MUST",
      "quote": "Implementations MUST accept non-canonical values and process them as if they had been reduced modulo the field prime."
    },
    {
      "id": "R-CLAMP",
      "section": "5",
      "level": "DEFINITION",
      "quote": "For X25519, in order to decode 32 random bytes as an integer scalar, set the three least significant bits of the first byte and the most significant bit of the last to zero, set the second most significant bit of the last byte to 1 and, finally, decode as little-endian."
    },
    {
      "id": "R-ENCODE",
      "section": "5",
      "level": "DEFINITION",
      "quote": "Finally, encode the resulting value as 32 or 56 bytes in little- endian order."
    },
    {
      "id": "R-OUT-MSB",
      "section": "5",
      "level": "MUST",
      "quote": "For X25519, the unused, most significant bit MUST be zero."
    },
    {
      "id": "R-ITER",
      "section": "5.2",
      "level": "DEFINITION",
      "quote": "For each iteration, set k to be the result of calling the function and u to be the old value of k."
    },
    {
      "id": "R-BASE",
      "section": "6.1",
      "level": "DEFINITION",
      "quote": "Alice generates 32 random bytes in a[0] to a[31] and transmits K_A = X25519(a, 9) to Bob, where 9 is the u-coordinate of the base point and is encoded as a byte with value 9, followed by 31 zero bytes."
    },
    {
      "id": "R-DH",
      "section": "6.1",
      "level": "DEFINITION",
      "quote": "Both now share K = X25519(a, X25519(b, 9)) = X25519(b, X25519(a, 9)) as a shared secret."
    }
  ],
  "exclusions": [
    {
      "section": "5",
      "quote": "The cswap function SHOULD be implemented in constant time (i.e., independent of the swap argument).",
      "reason": "timing is not observable by a functional test; nish checks it on the emitted machine code (tests/cases/ct_asm_x25519.ts, tests/ct-timing.js, docs/security/ct-verification.md, docs/security/crypto-ecc.md)"
    },
    {
      "section": "A",
      "quote": "The trace of Frobenius MUST NOT be in {0, 1} in order to rule out the attacks described in [smart], [satoh], and [semaev], as in [brainpool] and [safecurves].",
      "reason": "an obligation on choosing a curve, which Curve25519 already meets; nothing an implementation of X25519 does can satisfy or violate it"
    },
    {
      "section": "A",
      "quote": "MOV Degree [reducing]: the embedding degree MUST be greater than (order - 1) / 100, as in [brainpool] and [safecurves].",
      "reason": "an obligation on choosing a curve, which Curve25519 already meets; nothing an implementation of X25519 does can satisfy or violate it"
    },
    {
      "section": "A",
      "quote": "CM Discriminant: discriminant D MUST be greater than 2^100, as in [safecurves].",
      "reason": "an obligation on choosing a curve, which Curve25519 already meets; nothing an implementation of X25519 does can satisfy or violate it"
    }
  ],
