    {
      "kind": "property",
      "id": "P-CONSTRUCTION-256",
      "title": "HMAC-SHA-256 of a key of at most 64 bytes is the RFC 2104 construction over SHA-256",
      "covers": ["R-HMAC-SHA256"],
      "forall": [
        {
          "name": "key",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 64
        },
        {
          "name": "text",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 200
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "call": "hmacSha256",
            "args": [
              {
                "var": "key"
              },
              {
                "var": "text"
              }
            ]
          },
          {
            "call": "sha256",
            "args": [
              {
                "op": "concat",
                "args": [
                  {
                    "op": "xor",
                    "args": [
                      {
                        "op": "concat",
                        "args": [
                          {
                            "var": "key"
                          },
                          {
                            "op": "zeros",
                            "args": [
                              {
