  },
  "requirements": [
    {
      "id": "R-HMAC-SHA256",
      "section": "1",
      "level": "DEFINITION",
      "quote": "HMAC-SHA-256 is the realization of the HMAC message authentication code using the SHA-256 hash function",
      "note": "the properties below hold hmacSha256 to the HMAC construction of [HMAC] over nish/crypto/sha256 (block length 64 bytes, ipad 0x36, opad 0x5c, a key longer than the block hashed first) and to a 32-byte tag, and hmacSha256Verify to accept that tag and refuse it with any one bit flipped."
    },
    {
      "id": "R-HMAC-SHA384",
      "section": "1",
      "level": "DEFINITION",
      "quote": "HMAC-SHA-384 is the realization of the HMAC message authentication code using the SHA-384 hash function",
      "note": "as for SHA-256, with SHA-384, a block length of 128 bytes and a 48-byte tag."
    },
    {
      "id": "R-HMAC-SHA512",
      "section": "1",
      "level": "DEFINITION",
      "quote": "HMAC-SHA-512 is the realization of the HMAC message authentication code using the SHA-512 hash function",
      "note": "as for SHA-256, with SHA-512, a block length of 128 bytes and a 64-byte tag."
    },
    {
      "id": "R-SHORT-KEY",
      "section": "4.3",
      "level": "DEFINITION",
      "quote": "Test with a key shorter than the length of the HMAC output."
    },
    {
      "id": "R-KEY-DATA-64",
      "section": "4.4",
      "level": "DEFINITION",
      "quote": "Test with a combined length of key and data that is larger than 64 bytes (= block-size of SHA-224 and SHA-256)."
    },
    {
      "id": "R-TRUNC",
      "section": "4.6",
      "level": "DEFINITION",
      "quote": "Test with a truncation of output to 128 bits.",
      "note": "the functions return the whole tag, so test case 5 (Section 4.6 of [RFC4231]: a key of 20 bytes of 0x0c, the data \"Test With Truncation\") is written as a slice of it, its first 16 bytes."
    },
    {
      "id": "R-KEY-128",
      "section": "4.7",
      "level": "DEFINITION",
      "quote": "Test with a key larger than 128 bytes (= block-size of SHA-384 and SHA-512)."
    },
    {
      "id": "R-KEY-DATA-128",
      "section": "4.8",
      "level": "DEFINITION",
      "quote": "Test with a key and data that is larger than 128 bytes (= block-size of SHA-384 and SHA-512)."
    }
  ],
