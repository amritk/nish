{
  "$schema": "../build/vector/schemas/rfc-contract.json",
  "contract": "rfc7914-pbkdf2-sha256",
  "source": {
    "title": "PBKDF2-HMAC-SHA-256",
    "main": "rfc7914-pbkdf2-sha256",
    "sha256": "bfbd227e5103f502498cd8c070ef8fb2e587fa53dc2000850d1403eed7ecb9d4"
  },
  "sources": [
    {
      "id": "rfc7914-pbkdf2-sha256",
      "path": "../specs/rfc7914-pbkdf2-sha256.xml"
    },
    {
      "id": "rfc7914",
      "rfc": 7914,
      "path": "../rfcs/rfc7914.txt",
      "file": "rfcs/rfc7914.txt",
      "sha256": "df55932f8b6a5d271f36a634d91a25903724e189ba6c120bf7257cd47f10b197"
    }
  ],
  "target": {
    "module": "nish/crypto/hmac"
  },
  "requirements": [
    {
      "id": "R-PBKDF2",
      "source": "rfc7914",
      "section": "11",
      "level": "DEFINITION",
      "quote": "The test vectors below can be used to verify the PBKDF2-HMAC-SHA-256 [RFC2898] function."
    },
    {
      "id": "R-ASCII",
      "source": "rfc7914",
      "section": "11",
      "level": "DEFINITION",
      "quote": "The password and salt strings are passed as sequences of ASCII [RFC20] octets."
    },
    {
      "id": "R-REFUSE",
      "section": "3.1",
      "level": "MUST",
      "quote": "pbkdf2HmacSha256 MUST return null when the iteration count or the derived-key length is less than 1."
    }
  ],
  "exclusions": [],
  "functions": [
    {
      "name": "pbkdf2HmacSha256",
      "params": [
        {
          "name": "password",
          "type": "secret-bytes"
        },
        {
          "name": "salt",
          "type": "bytes"
        },
        {
          "name": "iterations",
          "type": "i32"
        },
        {
          "name": "length",
          "type": "i32"
        }
      ],
      "returns": "secret-bytes?"
    }
  ],
  "clauses": [
    {
      "kind": "vector",
      "id": "PBKDF2-1",
      "title": "RFC 7914 §11: one iteration, a 64-byte key",
      "covers": ["R-PBKDF2", "R-ASCII"],
      "source": {
        "command": "python3 -c 'import hashlib; print(hashlib.pbkdf2_hmac(\"sha256\", b\"passwd\", b\"salt\", 1, 64).hex())'"
      },
      "section": "5",
      "call": "pbkdf2HmacSha256",
      "args": [
        {
          "ascii": "passwd"
        },
        {
          "ascii": "salt"
        },
        {
          "int": 1
        },
        {
          "int": 64
        }
      ],
      "expect": {
        "hex": "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783"
      }
    },
    {
      "kind": "vector",
      "id": "PBKDF2-2",
      "title": "RFC 7914 §11: 80,000 iterations, a 64-byte key",
      "covers": ["R-PBKDF2", "R-ASCII"],
      "source": {
        "command": "python3 -c 'import hashlib; print(hashlib.pbkdf2_hmac(\"sha256\", b\"Password\", b\"NaCl\", 80000, 64).hex())'"
      },
      "section": "5",
      "call": "pbkdf2HmacSha256",
      "args": [
        {
          "ascii": "Password"
        },
        {
          "ascii": "NaCl"
        },
        {
          "int": 80000
        },
        {
          "int": 64
        }
      ],
      "expect": {
        "hex": "4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d"
      }
    },
    {
      "kind": "property",
      "id": "P-PREFIX",
      "title": "dkLen bytes, a prefix of every longer key",
      "covers": ["R-PBKDF2"],
      "forall": [
        {
          "name": "pw",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 24
        },
        {
          "name": "salt",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 24
        },
        {
          "name": "n",
          "type": "i32",
          "min": 1,
          "max": 3
        },
        {
          "name": "a",
          "type": "i32",
          "min": 1,
          "max": 40
        },
        {
          "name": "b",
          "type": "i32",
          "min": 0,
          "max": 40
        }
      ],
      "assert": {
        "let": [
          {
            "name": "k",
            "value": {
              "call": "pbkdf2HmacSha256",
              "args": [
                {
                  "var": "pw"
                },
                {
                  "var": "salt"
                },
                {
                  "var": "n"
                },
                {
                  "op": "+",
                  "args": [
                    {
                      "var": "a"
                    },
                    {
                      "var": "b"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "in": {
          "op": "and",
          "args": [
            {
              "op": "notNull",
              "args": [
                {
                  "var": "k"
                }
              ]
            },
            {
              "op": "==",
              "args": [
                {
                  "op": "len",
                  "args": [
                    {
                      "op": "unwrap",
                      "args": [
                        {
                          "var": "k"
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    {
                      "var": "a"
                    },
                    {
                      "var": "b"
                    }
                  ]
                }
              ]
            },
            {
              "op": "==",
              "args": [
                {
                  "op": "unwrap",
                  "args": [
                    {
                      "call": "pbkdf2HmacSha256",
                      "args": [
                        {
                          "var": "pw"
                        },
                        {
                          "var": "salt"
                        },
                        {
                          "var": "n"
                        },
                        {
                          "var": "a"
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "slice",
                  "args": [
                    {
                      "op": "unwrap",
                      "args": [
                        {
                          "var": "k"
                        }
                      ]
                    },
                    {
                      "int": 0
                    },
                    {
                      "var": "a"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "samples": 32
    },
    {
      "kind": "property",
      "id": "P-REFUSE",
      "title": "a count or a length below 1 is null",
      "covers": ["R-REFUSE"],
      "forall": [
        {
          "name": "pw",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 24
        },
        {
          "name": "salt",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 24
        },
        {
          "name": "n",
          "type": "i32",
          "min": -2,
          "max": 2
        },
        {
          "name": "len",
          "type": "i32",
          "min": -2,
          "max": 2
        }
      ],
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "implies",
            "args": [
              {
                "op": "or",
                "args": [
                  {
                    "op": "<",
                    "args": [
                      {
                        "var": "n"
                      },
                      {
                        "int": 1
                      }
                    ]
                  },
                  {
                    "op": "<",
                    "args": [
                      {
                        "var": "len"
                      },
                      {
                        "int": 1
                      }
                    ]
                  }
                ]
              },
              {
                "op": "isNull",
                "args": [
                  {
                    "call": "pbkdf2HmacSha256",
                    "args": [
                      {
                        "var": "pw"
                      },
                      {
                        "var": "salt"
                      },
                      {
                        "var": "n"
                      },
                      {
                        "var": "len"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "implies",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": ">=",
                    "args": [
                      {
                        "var": "n"
                      },
                      {
                        "int": 1
                      }
                    ]
                  },
                  {
                    "op": ">=",
                    "args": [
                      {
                        "var": "len"
                      },
                      {
                        "int": 1
                      }
                    ]
                  }
                ]
              },
              {
                "op": "notNull",
                "args": [
                  {
                    "call": "pbkdf2HmacSha256",
                    "args": [
                      {
                        "var": "pw"
                      },
                      {
                        "var": "salt"
                      },
                      {
                        "var": "n"
                      },
                      {
                        "var": "len"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "samples": 48
    }
  ]
}
