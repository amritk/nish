{
  "$schema": "../build/vector/schemas/rfc-contract.json",
  "contract": "rfc6979-p256-ecdsa",
  "source": {
    "rfc": 6979,
    "title": "Deterministic ECDSA on P-256 with SHA-256",
    "sha256": "456e8f17558fdbd206f968b96fc6f1b4a71ea331ab30ad17f711ab3adaa7d701"
  },
  "sources": [
    {
      "id": "rfc6979",
      "rfc": 6979,
      "file": "rfcs/rfc6979.txt",
      "sha256": "456e8f17558fdbd206f968b96fc6f1b4a71ea331ab30ad17f711ab3adaa7d701"
    }
  ],
  "target": {
    "module": "nish/crypto/p256"
  },
  "requirements": [
    {
      "id": "R-COMPAT",
      "section": "1",
      "level": "DEFINITION",
      "quote": "Produced signatures remain fully compatible with plain DSA and ECDSA."
    },
    {
      "id": "R-PRIV-RANGE",
      "section": "2.2",
      "level": "DEFINITION",
      "quote": "The relevant standards prescribe that x shall not be 0; hence, x is an integer in the range [1, q-1]."
    },
    {
      "id": "R-PUB",
      "section": "2.2",
      "level": "DEFINITION",
      "quote": "For ECDSA, the public key is the curve point: U = xG"
    },
    {
      "id": "R-TRUNCATE",
      "section": "2.3.2",
      "level": "DEFINITION",
      "quote": "if qlen < blen, then the qlen leftmost bits are kept, and subsequent bits are discarded;"
    },
    {
      "id": "R-EXPAND",
      "section": "2.3.2",
      "level": "DEFINITION",
      "quote": "otherwise, qlen-blen bits (of value zero) are added to the left of the sequence (i.e., before the input bits in the sequence order)."
    },
    {
      "id": "R-BITS2INT",
      "section": "2.3.5",
      "level": "DEFINITION",
      "quote": "bits2int is used during signature generation and verification in standard DSA and ECDSA to transform a hash value (computed over the input message) into an integer modulo q."
    },
    {
      "id": "R-HASH",
      "section": "2.4",
      "level": "DEFINITION",
      "quote": "The message is first processed by H, yielding the value H(m), which is a sequence of bits of length hlen."
    },
    {
      "id": "R-SIG-PAIR",
      "section": "2.4",
      "level": "DEFINITION",
      "quote": "The pair (r, s) is the signature."
    },
    {
      "id": "R-DETERMINISTIC",
      "section": "3",
      "level": "DEFINITION",
      "quote": "Deterministic (EC)DSA is the process of generating an (EC)DSA signature over an input message m by using the standard (EC)DSA signature generation process (discussed in the previous section), except that the value k, instead of being randomly generated, is obtained through the process described in this section."
    },
    {
      "id": "R-HMAC-H",
      "section": "3.1.1",
      "level": "DEFINITION",
      "quote": "Here, we use HMAC with the same hash function H as the one used to process the input message prior to signature generation or verification."
    },
    {
      "id": "R-MESSAGES",
      "section": "A.2",
      "level": "DEFINITION",
      "quote": "The two input messages are the UTF-8 encoding of the strings \"sample\" and \"test\" (without the quotes), of length 48 and 32 bits, respectively."
    }
  ],
  "exclusions": [
    {
      "section": "3.6",
      "quote": "The entropy of that additional data SHALL be at least n bits, preferably n+64 bits or more, where n is the target security level.",
      "reason": "a variant nish does not implement: the nonce is drawn from the private key and the digest alone, with no additional secret data"
    },
    {
      "section": "A.3",
      "quote": "The private key * MUST be set before generating the signature itself, but message * data can be input before setting the key.",
      "reason": "a comment in the Java sample code, on the order of calls to its class; nish/crypto/p256 takes the private key and the message in one call"
    },
    {
      "section": "A.3",
      "quote": "{@link #setPrivateKey} MUST have * been called.",
      "reason": "a comment on the sample code's sign(); nish/crypto/p256 takes the private key and the message in one call"
    },
    {
      "section": "A.3",
      "quote": "{@link #setPrivateKey} MUST * have been called.",
      "reason": "a comment on the sample code's signHash(); nish/crypto/p256 takes the private key and the digest in one call"
    }
  ],
