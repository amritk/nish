{
  "$schema": "../build/vector/schemas/rfc-contract.json",
  "contract": "rfc5869-hkdf-sha256",
  "source": {
    "rfc": 5869,
    "title": "HMAC-based Extract-and-Expand Key Derivation Function (HKDF)",
    "sha256": "7a40eb3835b35fc947eb12a2ed614db079d43b26e50dbc537c31fba16397089c"
  },
  "sources": [
    {
      "id": "rfc5869",
      "rfc": 5869,
      "file": "rfcs/rfc5869.txt",
      "sha256": "7a40eb3835b35fc947eb12a2ed614db079d43b26e50dbc537c31fba16397089c"
    }
  ],
  "target": {
    "module": "nish/crypto/hkdf"
  },
  "requirements": [
    {
      "id": "R-EXTRACT",
      "section": "2.2",
      "level": "DEFINITION",
      "quote": "PRK = HMAC-Hash(salt, IKM)"
    },
    {
      "id": "R-SALT",
      "section": "2.2",
      "level": "DEFINITION",
      "quote": "if not provided, it is set to a string of HashLen zeros."
    },
    {
      "id": "R-PRK-LEN",
      "section": "2.2",
      "level": "DEFINITION",
      "quote": "PRK a pseudorandom key (of HashLen octets)"
    },
    {
      "id": "R-L",
      "section": "2.3",
      "level": "DEFINITION",
      "quote": "L length of output keying material in octets (<= 255*HashLen)",
      "note": "The RFC states the bound; refusing a longer L with null is how nish/crypto/hkdf honours it."
    },
    {
      "id": "R-INFO-EMPTY",
      "section": "2.3",
      "level": "DEFINITION",
      "quote": "info optional context and application specific information (can be a zero-length string)"
    },
    {
      "id": "R-OKM-LEN",
      "section": "2.3",
      "level": "DEFINITION",
      "quote": "OKM output keying material (of L octets)"
    },
    {
      "id": "R-OKM-FIRST",
      "section": "2.3",
      "level": "DEFINITION",
      "quote": "OKM = first L octets of T"
    },
    {
      "id": "R-T",
      "section": "2.3",
      "level": "DEFINITION",
      "quote": "T(0) = empty string (zero length) T(1) = HMAC-Hash(PRK, T(0) | info | 0x01) T(2) = HMAC-Hash(PRK, T(1) | info | 0x02)"
    }
  ],
  "functions": [
    {
      "name": "hkdfExtractSha256",
      "params": [
        {
          "name": "salt",
          "type": "bytes"
        },
        {
          "name": "ikm",
          "type": "bytes"
        }
      ],
      "returns": "bytes"
    },
    {
      "name": "hkdfExpandSha256",
      "params": [
        {
          "name": "prk",
          "type": "bytes"
        },
        {
          "name": "info",
          "type": "bytes"
        },
        {
          "name": "length",
          "type": "i32"
        }
      ],
      "returns": "bytes?"
    },
    {
      "name": "hmacSha256",
      "module": "nish/crypto/hmac",
      "params": [
        {
          "name": "key",
          "type": "bytes"
        },
        {
          "name": "data",
          "type": "bytes"
        }
      ],
      "returns": "bytes"
    }
  ],
