    {
      "kind": "property",
      "id": "P-EXPAND-LENGTH",
      "title": "Expand gives exactly L octets for L <= 255*HashLen and refuses a longer L",
      "covers": ["R-L", "R-OKM-LEN"],
      "forall": [
        {
          "name": "prk",
          "type": "bytes",
          "minLen": 32,
          "maxLen": 64
        },
        {
          "name": "info",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 40
        },
        {
          "name": "n",
          "type": "i32",
          "min": 0,
          "max": 8300
        }
      ],
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "implies",
            "args": [
              {
                "op": "<=",
                "args": [
                  {
                    "var": "n"
                  },
                  {
                    "op": "*",
                    "args": [
                      {
                        "int": 255
                      },
                      {
                        "int": 32
                      }
                    ]
                  }
                ]
              },
              {
                "op": "and",
                "args": [
                  {
                    "op": "notNull",
                    "args": [
                      {
                        "call": "hkdfExpandSha256",
                        "args": [
                          {
                            "var": "prk"
                          },
                          {
                            "var": "info"
                          },
                          {
                            "var": "n"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "==",
                    "args": [
                      {
                        "op": "len",
                        "args": [
                          {
                            "op": "unwrap",
                            "args": [
                              {
                                "call": "hkdfExpandSha256",
                                "args": [
                                  {
                                    "var": "prk"
                                  },
                                  {
                                    "var": "info"
                                  },
                                  {
                                    "var": "n"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "var": "n"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "implies",
            "args": [
              {
                "op": ">",
                "args": [
                  {
                    "var": "n"
                  },
                  {
                    "op": "*",
                    "args": [
                      {
                        "int": 255
                      },
                      {
                        "int": 32
                      }
                    ]
                  }
                ]
              },
              {
                "op": "isNull",
                "args": [
                  {
                    "call": "hkdfExpandSha256",
                    "args": [
                      {
                        "var": "prk"
                      },
                      {
                        "var": "info"
                      },
                      {
                        "var": "n"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
