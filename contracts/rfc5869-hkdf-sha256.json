    {
      "kind": "property",
      "id": "P-EXTRACT-IS-HMAC",
      "title": "HKDF-Extract is HMAC-SHA-256 keyed by the salt",
      "covers": ["R-EXTRACT"],
      "forall": [
        {
          "name": "salt",
          "type": "bytes",
          "minLen": 1,
          "maxLen": 150
        },
        {
          "name": "ikm",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 150
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "call": "hkdfExtractSha256",
            "args": [
              {
                "var": "salt"
              },
              {
                "var": "ikm"
              }
            ]
          },
          {
            "call": "hmacSha256",
            "args": [
              {
                "var": "salt"
              },
              {
                "var": "ikm"
              }
            ]
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-EMPTY-SALT",
      "title": "an absent salt is HashLen zero octets",
      "covers": ["R-SALT"],
      "forall": [
        {
          "name": "ikm",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 150
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "call": "hkdfExtractSha256",
            "args": [
              {
                "hex": ""
              },
              {
                "var": "ikm"
              }
            ]
          },
          {
            "call": "hmacSha256",
            "args": [
              {
                "op": "zeros",
                "args": [
                  {
                    "int": 32
                  }
                ]
              },
              {
                "var": "ikm"
              }
            ]
          }
        ]
      }
    },
