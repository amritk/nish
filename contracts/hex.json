{
  "$schema": "https://raw.githubusercontent.com/amritk/vector/main/schemas/rfc-contract.json",
  "contract": "hex",
  "source": {
    "title": "Spec 0001: nish/hex — hexadecimal encoding and decoding",
    "main": "hex",
    "sha256": "48465b1d9c4aadb40f13b875fd1e289ca8a31190f308a89f925e73266a25996f"
  },
  "sources": [
    {
      "id": "hex",
      "path": "../specs/hex.md"
    },
    {
      "id": "rfc4648",
      "rfc": 4648
    }
  ],
  "target": {
    "module": "nish/hex"
  },
  "requirements": [
    {
      "id": "R-ENC-LEN",
      "section": "3.1",
      "level": "MUST",
      "quote": "hexEncode MUST return exactly two characters per input byte."
    },
    {
      "id": "R-ENC-DIGITS",
      "section": "3.2",
      "level": "MUST",
      "quote": "Each byte MUST be written high nibble first, using the digits 0-9 and a-f."
    },
    {
      "id": "R-ENC-ONLY",
      "section": "3.2",
      "level": "MUST NOT",
      "quote": "hexEncode MUST NOT emit uppercase digits, separators or a prefix."
    },
    {
      "id": "R-DEC-ACCEPT",
      "section": "4.1",
      "level": "MUST",
      "quote": "hexDecode MUST accept the digits 0-9, a-f and A-F, in any mix of case."
    },
    {
      "id": "R-DEC-REJECT",
      "section": "4.2",
      "level": "MUST",
      "quote": "hexDecode MUST return null when the text has an odd length or contains any other character, including whitespace and a \"0x\" prefix."
    },
    {
      "id": "R-DEC-EMPTY",
      "section": "4.3",
      "level": "MUST",
      "quote": "hexDecode of the empty string MUST return an empty array, not null."
    },
    {
      "id": "R-ROUND-TRIP",
      "section": "4.4",
      "level": "MUST",
      "quote": "For all bytes b, hexDecode(hexEncode(b)) MUST equal b."
    }
  ],
  "exclusions": [
    {
      "section": "5",
      "quote": "hexEncode and hexDecode MUST NOT branch on, or index memory by, the value of a byte of their input, so that their running time depends only on its length.",
      "reason": "How the code runs, not what it returns: no functional test observes a branch, an address or a running time. Checked in nish instead: tests/cases/ct_asm_hex.ts holds the per-byte code (the digit of a nibble, a digit's validity and value, one byte encoded, one pair decoded) to no branch, no call and no secret-addressed access after clang -O2 on x86-64 and aarch64, and tests/link/std_hex_ct_copies holds those copies to the module. The loops themselves branch on their counter, which that check refuses outright, so their -O3 listings were read by hand."
    }
  ],
  "functions": [
    {
      "name": "hexEncode",
      "params": [
        {
          "name": "bytes",
          "type": "bytes"
        }
      ],
      "returns": "string"
    },
    {
      "name": "hexDecode",
      "params": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "returns": "bytes?"
    }
  ],
  "clauses": [
