{
  "$schema": "../build/vector/schemas/rfc-contract.json",
  "contract": "scram-sha256",
  "source": {
    "title": "nish/crypto/scram — the SCRAM-SHA-256 client computation",
    "main": "scram-sha256",
    "sha256": "6019bba821145f0045359b5ae3ab652118b0588e79cf7a07af08f0c377652341"
  },
  "sources": [
    {
      "id": "scram-sha256",
      "path": "../specs/scram-sha256.xml"
    },
    {
      "id": "rfc5802",
      "rfc": 5802,
      "path": "../rfcs/rfc5802.txt",
      "file": "rfcs/rfc5802.txt",
      "sha256": "12fcaba0dd78fe7aeb1c63f433314722977ef6746a638fce0f168c63a5bd24ba"
    },
    {
      "id": "rfc7677",
      "rfc": 7677,
      "path": "../rfcs/rfc7677.txt",
      "file": "rfcs/rfc7677.txt",
      "sha256": "81490224a838bf5da7bfcce53e4ec1b1d2f69717c43c600111dec6652a386c71"
    }
  ],
  "target": {
    "module": "nish/crypto/scram"
  },
  "requirements": [
    {
      "id": "R-SHA256",
      "source": "rfc7677",
      "section": "3",
      "level": "DEFINITION",
      "quote": "the hash function for HMAC() and H() uses SHA-256 instead of SHA-1 [RFC6234]."
    },
    {
      "id": "R-SALTED",
      "source": "rfc5802",
      "section": "3",
      "level": "DEFINITION",
      "quote": "SaltedPassword := Hi(Normalize(password), salt, i)"
    },
    {
      "id": "R-HI",
      "source": "rfc5802",
      "section": "2.2",
      "level": "DEFINITION",
      "quote": "Hi() is, essentially, PBKDF2 [RFC2898] with HMAC() as the pseudorandom function (PRF) and with dkLen == output length of HMAC() == output length of H()."
    },
    {
      "id": "R-COUNT",
      "section": "4.1",
      "level": "MUST",
      "quote": "scramSha256SaltedPassword MUST return null when the iteration count is less than 1."
    },
    {
      "id": "R-CLIENT-KEY",
      "source": "rfc5802",
      "section": "3",
      "level": "DEFINITION",
      "quote": "ClientKey := HMAC(SaltedPassword, \"Client Key\") StoredKey := H(ClientKey)"
    },
    {
      "id": "R-PROOF",
      "source": "rfc5802",
      "section": "3",
      "level": "DEFINITION",
      "quote": "ClientSignature := HMAC(StoredKey, AuthMessage) ClientProof := ClientKey XOR ClientSignature"
    },
    {
      "id": "R-SERVER-SIG",
      "source": "rfc5802",
      "section": "3",
      "level": "DEFINITION",
      "quote": "ServerKey := HMAC(SaltedPassword, \"Server Key\") ServerSignature := HMAC(ServerKey, AuthMessage)"
    }
  ],
  "exclusions": [],
  "functions": [
    {
      "name": "scramSha256SaltedPassword",
      "params": [
        {
          "name": "password",
          "type": "secret-bytes"
        },
        {
          "name": "salt",
          "type": "bytes"
        },
        {
          "name": "iterations",
          "type": "i32"
        }
      ],
      "returns": "secret-bytes?"
    },
    {
      "name": "scramSha256ClientProof",
      "params": [
        {
          "name": "saltedPassword",
          "type": "secret-bytes"
        },
        {
          "name": "authMessage",
          "type": "bytes"
        }
      ],
      "returns": "bytes"
    },
    {
      "name": "scramSha256ServerSignature",
      "params": [
        {
          "name": "saltedPassword",
          "type": "secret-bytes"
        },
        {
          "name": "authMessage",
          "type": "bytes"
        }
      ],
      "returns": "bytes"
    },
    {
      "name": "pbkdf2HmacSha256",
      "module": "nish/crypto/hmac",
      "params": [
        {
          "name": "password",
          "type": "secret-bytes"
        },
        {
          "name": "salt",
          "type": "bytes"
        },
        {
          "name": "iterations",
          "type": "i32"
        },
        {
          "name": "length",
          "type": "i32"
        }
      ],
      "returns": "secret-bytes?"
    },
    {
      "name": "hmacSha256",
      "module": "nish/crypto/hmac",
      "params": [
        {
          "name": "key",
          "type": "bytes"
        },
        {
          "name": "data",
          "type": "bytes"
        }
      ],
      "returns": "bytes"
    },
    {
      "name": "sha256",
      "module": "nish/crypto/sha256",
      "params": [
        {
          "name": "data",
          "type": "bytes"
        }
      ],
      "returns": "bytes"
    }
  ],
  "clauses": [
    {
      "kind": "vector",
      "id": "S1",
      "title": "RFC 7677 §3: SaltedPassword for 'pencil' under the exchange's salt and count",
      "covers": ["R-SHA256", "R-SALTED", "R-HI"],
      "source": {
        "command": "python3 -c 'import base64, hashlib; print(hashlib.pbkdf2_hmac(\"sha256\", b\"pencil\", base64.b64decode(\"W22ZaJ0SNY7soEsUEjb6gQ==\"), 4096).hex())'"
      },
      "section": "9",
      "call": "scramSha256SaltedPassword",
      "args": [
        {
          "ascii": "pencil"
        },
        {
          "hex": "5b6d99689d12358eeca04b141236fa81"
        },
        {
          "int": 4096
        }
      ],
      "expect": {
        "hex": "c4a49510323ab4f952cac1fa99441939e78ea74d6be81ddf7096e87513dc615d"
      }
    },
    {
      "kind": "vector",
      "id": "S2",
      "title": "RFC 7677 §3: the client-final message's p=",
      "covers": ["R-SHA256", "R-CLIENT-KEY", "R-PROOF"],
      "source": {
        "command": "python3 -c 'import base64; print(base64.b64decode(\"dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=\").hex())'"
      },
      "section": "9",
      "call": "scramSha256ClientProof",
      "args": [
        {
          "hex": "c4a49510323ab4f952cac1fa99441939e78ea74d6be81ddf7096e87513dc615d"
        },
        {
          "ascii": "n=user,r=rOprNGfwEbeRWgbNEkqO,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096,c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0"
        }
      ],
      "expect": {
        "hex": "747cdb65aa56224e2352137e52d7bdcad6a0f738df30782caa69a2cfb0277554"
      }
    },
    {
      "kind": "vector",
      "id": "S3",
      "title": "RFC 7677 §3: the server-final message's v=",
      "covers": ["R-SHA256", "R-SERVER-SIG"],
      "source": {
        "command": "python3 -c 'import base64; print(base64.b64decode(\"6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=\").hex())'"
      },
      "section": "9",
      "call": "scramSha256ServerSignature",
      "args": [
        {
          "hex": "c4a49510323ab4f952cac1fa99441939e78ea74d6be81ddf7096e87513dc615d"
        },
        {
          "ascii": "n=user,r=rOprNGfwEbeRWgbNEkqO,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096,c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0"
        }
      ],
      "expect": {
        "hex": "eabae24d1062db75a9451ff0b6ea7e98c8546549ff741e672d3251b2397de46e"
      }
    },
    {
      "kind": "vector",
      "id": "S4",
      "title": "an iteration count of 0 is null",
      "covers": ["R-COUNT"],
      "source": {
        "spec": "4.1"
      },
      "section": "9",
      "call": "scramSha256SaltedPassword",
      "args": [
        {
          "ascii": "pencil"
        },
        {
          "hex": "5b6d99689d12358eeca04b141236fa81"
        },
        {
          "int": 0
        }
      ],
      "expect": {
        "null": true
      }
    },
    {
      "kind": "property",
      "id": "P-HI",
      "title": "SaltedPassword is PBKDF2-HMAC-SHA-256 with a 32-byte key",
      "covers": ["R-SALTED", "R-HI"],
      "forall": [
        {
          "name": "pw",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 24
        },
        {
          "name": "salt",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 24
        },
        {
          "name": "n",
          "type": "i32",
          "min": 1,
          "max": 3
        }
      ],
      "assert": {
        "let": [
          {
            "name": "sp",
            "value": {
              "call": "scramSha256SaltedPassword",
              "args": [
                {
                  "var": "pw"
                },
                {
                  "var": "salt"
                },
                {
                  "var": "n"
                }
              ]
            }
          }
        ],
        "in": {
          "op": "and",
          "args": [
            {
              "op": "notNull",
              "args": [
                {
                  "var": "sp"
                }
              ]
            },
            {
              "op": "==",
              "args": [
                {
                  "op": "len",
                  "args": [
                    {
                      "op": "unwrap",
                      "args": [
                        {
                          "var": "sp"
                        }
                      ]
                    }
                  ]
                },
                {
                  "int": 32
                }
              ]
            },
            {
              "op": "==",
              "args": [
                {
                  "op": "unwrap",
                  "args": [
                    {
                      "var": "sp"
                    }
                  ]
                },
                {
                  "op": "unwrap",
                  "args": [
                    {
                      "call": "pbkdf2HmacSha256",
                      "args": [
                        {
                          "var": "pw"
                        },
                        {
                          "var": "salt"
                        },
                        {
                          "var": "n"
                        },
                        {
                          "int": 32
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "samples": 32
    },
    {
      "kind": "property",
      "id": "P-COUNT",
      "title": "a count below 1 is null",
      "covers": ["R-COUNT"],
      "forall": [
        {
          "name": "pw",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 24
        },
        {
          "name": "salt",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 24
        },
        {
          "name": "n",
          "type": "i32",
          "min": -3,
          "max": 0
        }
      ],
      "assert": {
        "op": "isNull",
        "args": [
          {
            "call": "scramSha256SaltedPassword",
            "args": [
              {
                "var": "pw"
              },
              {
                "var": "salt"
              },
              {
                "var": "n"
              }
            ]
          }
        ]
      },
      "samples": 32
    },
    {
      "kind": "property",
      "id": "P-PROOF",
      "title": "ClientProof is ClientKey XOR HMAC(H(ClientKey), AuthMessage)",
      "covers": ["R-SHA256", "R-CLIENT-KEY", "R-PROOF"],
      "forall": [
        {
          "name": "sp",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 80
        },
        {
          "name": "am",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 96
        }
      ],
      "assert": {
        "let": [
          {
            "name": "ck",
            "value": {
              "call": "hmacSha256",
              "args": [
                {
                  "var": "sp"
                },
                {
                  "hex": "436c69656e74204b6579"
                }
              ]
            }
          }
        ],
        "in": {
          "op": "==",
          "args": [
            {
              "call": "scramSha256ClientProof",
              "args": [
                {
                  "var": "sp"
                },
                {
                  "var": "am"
                }
              ]
            },
            {
              "op": "xor",
              "args": [
                {
                  "var": "ck"
                },
                {
                  "call": "hmacSha256",
                  "args": [
                    {
                      "call": "sha256",
                      "args": [
                        {
                          "var": "ck"
                        }
                      ]
                    },
                    {
                      "var": "am"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "samples": 64
    },
    {
      "kind": "property",
      "id": "P-SERVER-SIG",
      "title": "ServerSignature is HMAC(HMAC(SaltedPassword, \"Server Key\"), AuthMessage)",
      "covers": ["R-SHA256", "R-SERVER-SIG"],
      "forall": [
        {
          "name": "sp",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 80
        },
        {
          "name": "am",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 96
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "call": "scramSha256ServerSignature",
            "args": [
              {
                "var": "sp"
              },
              {
                "var": "am"
              }
            ]
          },
          {
            "call": "hmacSha256",
            "args": [
              {
                "call": "hmacSha256",
                "args": [
                  {
                    "var": "sp"
                  },
                  {
                    "hex": "536572766572204b6579"
                  }
                ]
              },
              {
                "var": "am"
              }
            ]
          }
        ]
      },
      "samples": 64
    }
  ]
}
