    },
    {
      "kind": "vector",
      "id": "S4",
      "title": "an iteration count of 0 is null",
      "covers": ["R-COUNT"],
      "source": {
        "spec": "4.1"
      },
      "section": "8",
      "call": "scramSha256SaltedPassword",
      "args": [
        {
          "ascii": "pencil"
        },
        {
          "hex": "5b6d99689d12358eeca04b141236fa81"
        },
        {
          "int": 0
        }
      ],
      "expect": {
        "null": true
      }
    }
  ]
}
