{
  "$schema": "../build/vector/schemas/rfc-contract.json",
  "contract": "rfc8032-ed25519",
  "source": {
    "rfc": 8032,
    "title": "Edwards-Curve Digital Signature Algorithm (EdDSA)",
    "sha256": "ed63657ff389301282b169b0abde9b5dd2c7e4d524fdfa5da6ff3094fc93c4c3"
  },
  "sources": [
    {
      "id": "rfc8032",
      "rfc": 8032,
      "file": "rfcs/rfc8032.txt",
      "sha256": "ed63657ff389301282b169b0abde9b5dd2c7e4d524fdfa5da6ff3094fc93c4c3"
    }
  ],
  "target": {
    "module": "nish/crypto/ed25519"
  },
  "requirements": [
    {
      "id": "R-PURE",
      "section": "5.1",
      "level": "DEFINITION",
      "quote": "For Ed25519, dom2(f,c) is the empty string."
    },
    {
      "id": "R-PUB-32",
      "section": "5.1.5",
      "level": "DEFINITION",
      "quote": "The 32-byte public key is generated by the following steps."
    },
    {
      "id": "R-PUB-ENCODE",
      "section": "5.1.5",
      "level": "DEFINITION",
      "quote": "The public key A is the encoding of the point [s]B."
    },
    {
      "id": "R-SIG-FORM",
      "section": "5.1.6",
      "level": "DEFINITION",
      "quote": "Form the signature of the concatenation of R (32 octets) and the little-endian encoding of S (32 octets; the three most significant bits of the final octet are always zero)."
    },
    {
      "id": "R-VERIFY-DECODE",
      "section": "5.1.7",
      "level": "DEFINITION",
      "quote": "If any of the decodings fail (including S being out of range), the signature is invalid."
    },
    {
      "id": "R-VERIFY-EQ",
      "section": "5.1.7",
      "level": "DEFINITION",
      "quote": "Check the group equation [8][S]B = [8]R + [8][k]A'."
    }
  ],
  "exclusions": [
    {
      "section": "5.1",
      "quote": "The context (if present at all) MUST be empty.",
      "reason": "nish implements PureEdDSA Ed25519 only: no function takes a context, so it is always empty"
    },
    {
      "section": "8.7",
      "quote": "In particular, unless the underlying protocol does not require it, the receiver MUST buffer the entire message (or enough information to reconstruct it, e.g., compressed or encrypted version) to be verified.",
      "reason": "an obligation on the caller: ed25519Verify takes the whole message, and what the receiver does with it is outside the module"
    }
  ],
  "functions": [
    {
      "name": "ed25519PublicKey",
      "params": [
        {
          "name": "seed",
          "type": "secret-bytes"
        }
      ],
      "returns": "bytes?"
    },
    {
      "name": "ed25519Sign",
      "params": [
        {
          "name": "seed",
          "type": "secret-bytes"
        },
        {
          "name": "msg",
          "type": "bytes"
        }
      ],
      "returns": "bytes?"
    },
    {
      "name": "ed25519Verify",
      "params": [
        {
          "name": "pub",
          "type": "bytes"
        },
        {
          "name": "msg",
          "type": "bytes"
        },
        {
          "name": "sig",
          "type": "bytes"
        }
      ],
      "returns": "bool"
    }
  ],
  "clauses": [
    {
      "kind": "vector",
      "id": "7.1-T1-PUB",
      "title": "RFC 8032 7.1 TEST 1: the public key",
      "covers": ["R-PUB-ENCODE"],
      "source": {
        "cite": {
          "section": "7.1"
        }
      },
      "call": "ed25519PublicKey",
      "args": [
        {
          "hex": "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
          "label": "SECRET KEY"
        }
      ],
      "expect": {
        "hex": "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
        "label": "PUBLIC KEY"
      }
    },
    {
      "kind": "vector",
      "id": "7.1-T2-PUB",
      "title": "RFC 8032 7.1 TEST 2: the public key",
      "covers": ["R-PUB-ENCODE"],
      "source": {
        "cite": {
          "section": "7.1"
        }
      },
      "call": "ed25519PublicKey",
      "args": [
        {
          "hex": "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
          "label": "SECRET KEY"
        }
      ],
      "expect": {
        "hex": "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
        "label": "PUBLIC KEY"
      }
    },
    {
      "kind": "vector",
      "id": "7.1-T3-PUB",
      "title": "RFC 8032 7.1 TEST 3: the public key",
      "covers": ["R-PUB-ENCODE"],
      "source": {
        "cite": {
          "section": "7.1"
        }
      },
      "call": "ed25519PublicKey",
      "args": [
        {
          "hex": "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
          "label": "SECRET KEY"
        }
      ],
      "expect": {
        "hex": "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
        "label": "PUBLIC KEY"
      }
    },
    {
      "kind": "vector",
      "id": "7.1-T1024-PUB",
      "title": "RFC 8032 7.1 TEST 1024: the public key",
      "covers": ["R-PUB-ENCODE"],
      "source": {
        "cite": {
          "section": "7.1"
        }
      },
      "call": "ed25519PublicKey",
      "args": [
        {
          "hex": "f5e5767cf153319517630f226876b86c8160cc583bc013744c6bf255f5cc0ee5",
          "label": "SECRET KEY"
        }
      ],
      "expect": {
        "hex": "278117fc144c72340f67d0f2316e8386ceffbf2b2428c9c51fef7c597f1d426e",
        "label": "PUBLIC KEY"
      }
    },
    {
      "kind": "vector",
      "id": "7.1-TABC-PUB",
      "title": "RFC 8032 7.1 TEST SHA(abc): the public key",
      "covers": ["R-PUB-ENCODE"],
      "source": {
        "cite": {
          "section": "7.1"
        }
      },
      "call": "ed25519PublicKey",
      "args": [
        {
          "hex": "833fe62409237b9d62ec77587520911e9a759cec1d19755b7da901b96dca3d42",
          "label": "SECRET KEY"
        }
      ],
      "expect": {
        "hex": "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf",
        "label": "PUBLIC KEY"
      }
    },
    {
      "kind": "property",
      "id": "P-PUB-32",
      "title": "any 32-octet seed gives a 32-byte public key",
      "covers": ["R-PUB-32"],
      "forall": [
        {
          "name": "seed",
          "type": "bytes",
          "minLen": 32,
          "maxLen": 32
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "op": "unwrap",
                "args": [
                  {
                    "call": "ed25519PublicKey",
                    "args": [
                      {
                        "var": "seed"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "int": 32
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-SIG-FORM",
      "title": "a signature is 64 octets and the three most significant bits of its final octet are zero",
      "covers": ["R-SIG-FORM"],
      "forall": [
        {
          "name": "seed",
          "type": "bytes",
          "minLen": 32,
          "maxLen": 32
        },
        {
          "name": "msg",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 300
        }
      ],
      "assert": {
        "let": [
          {
            "name": "sig",
            "value": {
              "op": "unwrap",
              "args": [
                {
                  "call": "ed25519Sign",
                  "args": [
                    {
                      "var": "seed"
                    },
                    {
                      "var": "msg"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "in": {
          "op": "and",
          "args": [
            {
              "op": "==",
              "args": [
                {
                  "op": "len",
                  "args": [
                    {
                      "var": "sig"
                    }
                  ]
                },
                {
                  "int": 64
                }
              ]
            },
            {
              "op": "==",
              "args": [
                {
                  "op": "bitAnd",
                  "args": [
                    {
                      "op": "slice",
                      "args": [
                        {
                          "var": "sig"
                        },
                        {
                          "int": 63
                        },
                        {
                          "int": 64
                        }
                      ]
                    },
                    {
                      "op": "fill",
                      "args": [
                        {
                          "int": 224
                        },
                        {
                          "int": 1
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "zeros",
                  "args": [
                    {
                      "int": 1
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "kind": "property",
      "id": "P-ROUNDTRIP",
      "title": "a signature verifies under the seed's public key",
      "covers": ["R-VERIFY-EQ", "R-PURE"],
      "forall": [
        {
          "name": "seed",
          "type": "bytes",
          "minLen": 32,
          "maxLen": 32
        },
        {
          "name": "msg",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 300
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "call": "ed25519Verify",
            "args": [
              {
                "op": "unwrap",
                "args": [
                  {
                    "call": "ed25519PublicKey",
                    "args": [
                      {
                        "var": "seed"
                      }
                    ]
                  }
                ]
              },
              {
                "var": "msg"
              },
              {
                "op": "unwrap",
                "args": [
                  {
                    "call": "ed25519Sign",
                    "args": [
                      {
                        "var": "seed"
                      },
                      {
                        "var": "msg"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "bool": true
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-TAMPER-SIG",
      "title": "flipping any one bit of the signature makes it invalid",
      "covers": ["R-VERIFY-EQ"],
      "forall": [
        {
          "name": "seed",
          "type": "bytes",
          "minLen": 32,
          "maxLen": 32
        },
        {
          "name": "msg",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 100
        },
        {
          "name": "bit",
          "type": "i32",
          "min": 0,
          "max": 511
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "call": "ed25519Verify",
            "args": [
              {
                "op": "unwrap",
                "args": [
                  {
                    "call": "ed25519PublicKey",
                    "args": [
                      {
                        "var": "seed"
                      }
                    ]
                  }
                ]
              },
              {
                "var": "msg"
              },
              {
                "op": "flipBit",
                "args": [
                  {
                    "op": "unwrap",
                    "args": [
                      {
                        "call": "ed25519Sign",
                        "args": [
                          {
                            "var": "seed"
                          },
                          {
                            "var": "msg"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "var": "bit"
                  }
                ]
              }
            ]
          },
          {
            "bool": false
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-TAMPER-MSG",
      "title": "flipping any one bit of the message makes the signature invalid",
      "covers": ["R-VERIFY-EQ"],
      "forall": [
        {
          "name": "seed",
          "type": "bytes",
          "minLen": 32,
          "maxLen": 32
        },
        {
          "name": "msg",
          "type": "bytes",
          "minLen": 1,
          "maxLen": 100
        },
        {
          "name": "bit",
          "type": "i32",
          "min": 0,
          "max": 799
        }
      ],
      "where": {
        "op": "<",
        "args": [
          {
            "var": "bit"
          },
          {
            "op": "*",
            "args": [
              {
                "int": 8
              },
              {
                "op": "len",
                "args": [
                  {
                    "var": "msg"
                  }
                ]
              }
            ]
          }
        ]
      },
      "assert": {
        "op": "==",
        "args": [
          {
            "call": "ed25519Verify",
            "args": [
              {
                "op": "unwrap",
                "args": [
                  {
                    "call": "ed25519PublicKey",
                    "args": [
                      {
                        "var": "seed"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "flipBit",
                "args": [
                  {
                    "var": "msg"
                  },
                  {
                    "var": "bit"
                  }
                ]
              },
              {
                "op": "unwrap",
                "args": [
                  {
                    "call": "ed25519Sign",
                    "args": [
                      {
                        "var": "seed"
                      },
                      {
                        "var": "msg"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "bool": false
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-S-RANGE",
      "title": "setting any of the three top bits of S puts it out of range, and the signature is invalid",
      "covers": ["R-VERIFY-DECODE"],
      "forall": [
        {
          "name": "seed",
          "type": "bytes",
          "minLen": 32,
          "maxLen": 32
        },
        {
          "name": "msg",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 100
        },
        {
          "name": "bit",
          "type": "i32",
          "min": 509,
          "max": 511
        }
      ],
      "assert": {
        "op": "==",
        "args": [
          {
            "call": "ed25519Verify",
            "args": [
              {
                "op": "unwrap",
                "args": [
                  {
                    "call": "ed25519PublicKey",
                    "args": [
                      {
                        "var": "seed"
                      }
                    ]
                  }
                ]
              },
              {
                "var": "msg"
              },
              {
                "op": "flipBit",
                "args": [
                  {
                    "op": "unwrap",
                    "args": [
                      {
                        "call": "ed25519Sign",
                        "args": [
                          {
                            "var": "seed"
                          },
                          {
                            "var": "msg"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "var": "bit"
                  }
                ]
              }
            ]
          },
          {
            "bool": false
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-SIZES",
      "title": "a public key other than 32 octets or a signature other than 64 is invalid",
      "covers": ["R-VERIFY-DECODE"],
      "forall": [
        {
          "name": "seed",
          "type": "bytes",
          "minLen": 32,
          "maxLen": 32
        },
        {
          "name": "msg",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 40
        },
        {
          "name": "cut",
          "type": "i32",
          "min": 1,
          "max": 32
        }
      ],
      "assert": {
        "let": [
          {
            "name": "pub",
            "value": {
              "op": "unwrap",
              "args": [
                {
                  "call": "ed25519PublicKey",
                  "args": [
                    {
                      "var": "seed"
                    }
                  ]
                }
              ]
            }
          },
          {
            "name": "sig",
            "value": {
              "op": "unwrap",
              "args": [
                {
                  "call": "ed25519Sign",
                  "args": [
                    {
                      "var": "seed"
                    },
                    {
                      "var": "msg"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "in": {
          "op": "and",
          "args": [
            {
              "op": "==",
              "args": [
                {
                  "call": "ed25519Verify",
                  "args": [
                    {
                      "op": "slice",
                      "args": [
                        {
                          "var": "pub"
                        },
                        {
                          "int": 0
                        },
                        {
                          "op": "-",
                          "args": [
                            {
                              "int": 32
                            },
                            {
                              "var": "cut"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "var": "msg"
                    },
                    {
                      "var": "sig"
                    }
                  ]
                },
                {
                  "bool": false
                }
              ]
            },
            {
              "op": "==",
              "args": [
                {
                  "call": "ed25519Verify",
                  "args": [
                    {
                      "var": "pub"
                    },
                    {
                      "var": "msg"
                    },
                    {
                      "op": "slice",
                      "args": [
                        {
                          "var": "sig"
                        },
                        {
                          "int": 0
                        },
                        {
                          "op": "-",
                          "args": [
                            {
                              "int": 64
                            },
                            {
                              "var": "cut"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "bool": false
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
