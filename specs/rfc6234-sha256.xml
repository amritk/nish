      </blockquote>
      <t>Untested: a term of the licence on the RFC's C code, which nish does not copy; no behaviour of a hash function can satisfy or violate it</t>
    </section>
    <section anchor="properties">
      <name>Properties</name>
      <sourcecode type="ts-property"><![CDATA[
// P-LEN-256 covers R-DIGEST, R-SHA256-OUT — sha256 gives 32 bytes for any message
forall (m: u8[] /* 0..300 */) => sha256(m).length === 32
]]></sourcecode>
      <sourcecode type="ts-property"><![CDATA[
// P-CHUNK covers R-DIGEST — the digest depends on every byte: appending one byte changes it
forall (m: u8[] /* 0..300 */, b: u8[] /* 1..1 */) => sha256(m) !== sha256(m.concat(b))
]]></sourcecode>
    </section>
