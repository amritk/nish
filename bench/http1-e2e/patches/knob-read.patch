+   * once the parser has closed or refused, where `feed` would drop the input.
+   */
+  readFrom(fd: i32, ask: i32): i32 {
+    if (this.state === HTTP1_S_CLOSED || this.state === HTTP1_S_ERROR) {
+      return -1000
+    }
