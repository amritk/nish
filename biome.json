{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "bin/**/*.js",
      "self/**/*.ts",
      "std/**/*.ts",
      "tests/self/**/*.ts",
      "tests/**/*.js",
      "examples/**",
      "docs/cookbook/**/*.ts",
      "docs/*.mjs",
      "bench/**/*.ts",
      "bench/**/*.mjs",
      "web/**/*.mjs",
      "scripts/**/*.mjs",
      "scripts/**/*.js",
      ".claude/hooks/*.mjs",
      "!**/build",
      "!**/node_modules",
      "!tests/cases"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noVoid": "error",
        "useOptionalChain": "off",
        "useArrowFunction": "error",
        "noForEach": "warn",
        "noUselessUndefinedInitialization": "warn",
        "noUselessStringConcat": "warn"
      },
      "style": {
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterAssign": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useExplicitLengthCheck": "error",
        "useExponentiationOperator": "off",
        "useFilenamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "filenameCases": [
              "kebab-case"
            ]
          }
        },
        "useImportType": "off",
        "useTemplate": "off",
        "noNonNullAssertion": "off",
        "useConsistentTypeDefinitions": {
          "level": "warn",
          "options": {
            "style": "type"
          }
        },
        "useConsistentMethodSignatures": {
          "level": "warn",
          "options": {
            "style": "property"
          }
        },
        "useShorthandFunctionType": "error",
        "useConsistentArrowReturn": "error",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "conventions": [
              {
                "selector": {
                  "kind": "const"
                },
                "formats": [
                  "camelCase",
                  "PascalCase",
                  "CONSTANT_CASE"
                ]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": [
                  "camelCase",
                  "CONSTANT_CASE"
                ]
              }
            ]
          }
        },
        "useBlockStatements": "warn",
        "useShorthandAssign": "warn",
        "useConst": "warn",
        "noUselessElse": "warn",
        "useCollapsedElseIf": "warn",
        "noUnusedTemplateLiteral": "warn",
        "useForOf": "warn",
        "noNestedTernary": "warn",
        "useNumberNamespace": "warn",
        "noYodaExpression": "warn",
        "useSingleVarDeclarator": "warn",
        "useThrowNewError": "warn",
        "useThrowOnlyError": "warn",
        "noDefaultExport": "warn",
        "noCommonJs": "warn",
        "useNodejsImportProtocol": "warn",
        "noExportedImports": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noVar": "error",
        "noShadow": "warn",
        "noEmptyBlockStatements": "warn",
        "useAwait": "warn",
        "noEvolvingTypes": "warn",
        "useErrorMessage": "warn",
        "noTsIgnore": "error",
        "noExportsInTest": "error",
        "useGuardForIn": "error"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedPrivateClassMembers": "warn",
        "noGlobalDirnameFilename": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "examples/**",
        "docs/cookbook/**",
        "bench/**/*.ts",
        "self/**/*.ts",
        "std/**/*.ts",
        "tests/self/**/*.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off",
            "noPrecisionLoss": "off"
          },
          "suspicious": {
            "noApproximativeNumericConstant": "off"
          },
          "style": {
            "useConsistentTypeDefinitions": "off",
            "useConsistentMethodSignatures": "off",
            "noEnum": "off",
            "useNumberNamespace": "off",
            "useShorthandAssign": "off",
            "useForOf": "off"
          }
        }
      }
    },
    {
      "includes": [
        "self/**/*.ts",
        "tests/**/*.js",
        "docs/*.mjs",
        "bench/**/*.mjs",
        "web/**/*.mjs",
        "examples/*.mjs",
        "scripts/**/*.mjs",
        "scripts/**/*.js",
        ".claude/hooks/*.mjs"
      ],
      "plugins": [
        "biome-plugins/no-function-declaration.grit"
      ]
    },
    {
      "includes": [
        "web/wasi.mjs",
        ".claude/hooks/*.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "warn",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "conventions": [
                  {
                    "selector": {
                      "kind": "objectLiteralProperty"
                    },
                    "formats": [
                      "camelCase",
                      "snake_case"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "self/**/*.ts",
        "std/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/tests/**",
                      "**/scripts/**",
                      "**/bench/**",
                      "**/examples/**"
                    ],
                    "message": "The compiler and the standard library ship; they may not import from tests/, scripts/, bench/ or examples/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
