{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**/*.js",
      "examples/**",
      "docs/cookbook/**/*.ts",
      "docs/*.mjs",
      "bench/**/*.ts",
      "bench/**/*.mjs",
      "!**/dist",
      "!**/build",
      "!**/node_modules",
      "!tests/cases"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noVoid": "error",
        "useOptionalChain": "off"
      },
      "style": {
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterAssign": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useExplicitLengthCheck": "error",
        "useExponentiationOperator": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "filenameCases": [
              "kebab-case",
              "snake_case"
            ]
          }
        },
        "useImportType": "off",
        "useTemplate": "off",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noVar": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "examples/**",
        "docs/cookbook/**",
        "bench/**/*.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off",
            "noPrecisionLoss": "off"
          },
          "suspicious": {
            "noApproximativeNumericConstant": "off"
          }
        }
      }
    }
  ]
}
